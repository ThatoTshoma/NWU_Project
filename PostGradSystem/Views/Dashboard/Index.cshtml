@model PostGradSystem.Models.DashboardViewModel

@{
    ViewData["Title"] = "SDMS Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>NWU · SDMS Dashboard</title>

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

    <style>
        :root {
            --bg: #0b0f1a;
            --surface: #111827;
            --surface2: #1a2235;
            --border: #1f2d45;
            --accent: #3b82f6;
            --accent2: #06b6d4;
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --muted: #64748b;
            --text: #e2e8f0;
            --text-dim: #94a3b8;
            --gold: #fbbf24;
        }

        *, * before, * after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background: var(--bg);
            color: var(--text);
            font-family: 'DM Sans', sans-serif;
            font-size: 14px;
            line-height: 1.6;
            min-height: 100vh;
        }

        /* ── Sidebar ── */
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: 220px;
            height: 100vh;
            background: var(--surface);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            padding: 28px 20px;
            z-index: 100;
        }

        .sidebar-logo {
            font-family: 'Syne', sans-serif;
            font-weight: 800;
            font-size: 18px;
            color: var(--accent);
            letter-spacing: -0.5px;
            margin-bottom: 6px;
        }

        .sidebar-sub {
            font-size: 11px;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 1.5px;
            margin-bottom: 36px;
        }

        .nav-label {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: var(--muted);
            margin-bottom: 10px;
            margin-top: 24px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 12px;
            border-radius: 8px;
            color: var(--text-dim);
            font-size: 13.5px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.15s;
            margin-bottom: 2px;
            text-decoration: none;
        }

            .nav-item:hover, .nav-item.active {
                background: var(--surface2);
                color: var(--text);
            }

            .nav-item.active {
                color: var(--accent);
            }

        .nav-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--accent);
            flex-shrink: 0;
        }

        .sidebar-footer {
            margin-top: auto;
            padding-top: 20px;
            border-top: 1px solid var(--border);
            font-size: 11px;
            color: var(--muted);
        }

        /* ── Main Layout ── */
        .main {
            margin-left: 220px;
            padding: 32px 36px;
            min-height: 100vh;
        }

        /* ── Header ── */
        .page-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            margin-bottom: 32px;
        }

        .page-title {
            font-family: 'Syne', sans-serif;
            font-size: 26px;
            font-weight: 800;
            letter-spacing: -0.5px;
            color: var(--text);
        }

        .page-subtitle {
            font-size: 13px;
            color: var(--muted);
            margin-top: 3px;
        }

        .header-badge {
            background: var(--surface2);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 6px 14px;
            font-size: 12px;
            color: var(--text-dim);
        }

            .header-badge span {
                color: var(--accent);
                font-weight: 600;
            }

        /* ── KPI Cards ── */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 28px;
        }

        .kpi-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 20px;
            position: relative;
            overflow: hidden;
            transition: transform 0.2s, border-color 0.2s;
        }

            .kpi-card:hover {
                transform: translateY(-2px);
                border-color: var(--accent);
            }

            .kpi-card before {
                content: '';
                position: absolute;
                top: 0;
                right: 0;
                width: 80px;
                height: 80px;
                border-radius: 50%;
                opacity: 0.08;
                transform: translate(20px, -20px);
            }

            .kpi-card.blue before {
                background: var(--accent);
            }

            .kpi-card.cyan before {
                background: var(--accent2);
            }

            .kpi-card.green before {
                background: var(--success);
            }

            .kpi-card.red before {
                background: var(--danger);
            }

            .kpi-card.amber before {
                background: var(--warning);
            }

            .kpi-card.gold before {
                background: var(--gold);
            }

            .kpi-card.purple before {
                background: #a855f7;
            }

        .kpi-icon {
            font-size: 22px;
            margin-bottom: 12px;
        }

        .kpi-label {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--muted);
            margin-bottom: 6px;
        }

        .kpi-value {
            font-family: 'Syne', sans-serif;
            font-size: 28px;
            font-weight: 800;
            letter-spacing: -1px;
            line-height: 1;
        }

        .kpi-card.blue .kpi-value {
            color: var(--accent);
        }

        .kpi-card.cyan .kpi-value {
            color: var(--accent2);
        }

        .kpi-card.green .kpi-value {
            color: var(--success);
        }

        .kpi-card.red .kpi-value {
            color: var(--danger);
        }

        .kpi-card.amber .kpi-value {
            color: var(--warning);
        }

        .kpi-card.gold .kpi-value {
            color: var(--gold);
        }

        .kpi-card.purple .kpi-value {
            color: #a855f7;
        }

        .kpi-sub {
            font-size: 11px;
            color: var(--muted);
            margin-top: 6px;
        }

        /* ── Section label ── */
        .section-label {
            font-family: 'Syne', sans-serif;
            font-size: 13px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: var(--muted);
            margin-bottom: 14px;
            margin-top: 8px;
        }

        /* ── Chart Grid ── */
        .chart-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            margin-bottom: 28px;
        }

        .chart-grid-2 {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
            margin-bottom: 28px;
        }

        .chart-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 20px;
        }

        .chart-title {
            font-family: 'Syne', sans-serif;
            font-size: 13px;
            font-weight: 700;
            color: var(--text);
            margin-bottom: 4px;
        }

        .chart-desc {
            font-size: 11px;
            color: var(--muted);
            margin-bottom: 16px;
        }

        .chart-wrap {
            position: relative;
            height: 200px;
        }

        /* ── Table ── */
        .table-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 14px;
            overflow: hidden;
            margin-bottom: 28px;
        }

        .table-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 18px 22px;
            border-bottom: 1px solid var(--border);
        }

        .table-header-title {
            font-family: 'Syne', sans-serif;
            font-size: 15px;
            font-weight: 700;
        }

        .table-count {
            font-size: 12px;
            color: var(--muted);
            background: var(--surface2);
            border: 1px solid var(--border);
            padding: 3px 10px;
            border-radius: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        thead th {
            padding: 11px 16px;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--muted);
            background: var(--surface2);
            border-bottom: 1px solid var(--border);
            text-align: left;
            font-weight: 600;
        }

        tbody tr {
            border-bottom: 1px solid var(--border);
            transition: background 0.15s;
        }

            tbody tr:last-child {
                border-bottom: none;
            }

            tbody tr:hover {
                background: var(--surface2);
            }

        tbody td {
            padding: 12px 16px;
            font-size: 13px;
            color: var(--text-dim);
            vertical-align: middle;
        }

            tbody td:first-child {
                color: var(--text);
                font-weight: 500;
            }

        /* ── Badges ── */
        .badge {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.3px;
        }

        .badge-active {
            background: rgba(16,185,129,0.15);
            color: var(--success);
        }

        .badge-inactive {
            background: rgba(100,116,139,0.15);
            color: var(--muted);
        }

        .badge-flagged {
            background: rgba(239,68,68,0.15);
            color: var(--danger);
        }

        .badge-clear {
            background: rgba(16,185,129,0.1);
            color: var(--success);
        }

        .badge-partial {
            background: rgba(245,158,11,0.15);
            color: var(--warning);
        }

        .badge-paid {
            background: rgba(16,185,129,0.15);
            color: var(--success);
        }

        .badge-unpaid {
            background: rgba(239,68,68,0.15);
            color: var(--danger);
        }

        /* ── Progress bar ── */
        .progress-wrap {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .progress-bar {
            flex: 1;
            height: 4px;
            background: var(--surface2);
            border-radius: 4px;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            border-radius: 4px;
            background: var(--accent);
        }

            .progress-fill.green {
                background: var(--success);
            }

            .progress-fill.amber {
                background: var(--warning);
            }

            .progress-fill.red {
                background: var(--danger);
            }

        .progress-val {
            font-size: 12px;
            color: var(--text-dim);
            min-width: 36px;
            text-align: right;
        }

        /* ── Score pill ── */
        .score-pill {
            font-family: 'Syne', sans-serif;
            font-size: 13px;
            font-weight: 700;
        }

        .score-high {
            color: var(--success);
        }

        .score-mid {
            color: var(--warning);
        }

        .score-low {
            color: var(--danger);
        }

        /* ── Search ── */
        .search-wrap {
            position: relative;
            margin-bottom: 0;
        }

        .search-input {
            background: var(--surface2);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 8px 14px 8px 36px;
            color: var(--text);
            font-size: 13px;
            width: 220px;
            outline: none;
            transition: border-color 0.2s;
        }

            .search-input:focus {
                border-color: var(--accent);
            }

            .search-input placeholder {
                color: var(--muted);
            }

        .search-icon {
            position: absolute;
            left: 11px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--muted);
            font-size: 14px;
        }

        /* ── Scrollbar ── */
         -webkit-scrollbar {
            width: 5px;
        }

         -webkit-scrollbar-track {
            background: var(--bg);
        }

         -webkit-scrollbar-thumb {
            background: var(--border);
            border-radius: 4px;
        }

        /* ── Animations ── */
        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(16px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .kpi-card {
            animation: fadeUp 0.4s ease both;
        }

        .chart-card {
            animation: fadeUp 0.5s ease both;
        }

        .table-card {
            animation: fadeUp 0.5s ease both;
        }

        .kpi-card:nth-child(1) {
            animation-delay: 0.05s;
        }

        .kpi-card:nth-child(2) {
            animation-delay: 0.10s;
        }

        .kpi-card:nth-child(3) {
            animation-delay: 0.15s;
        }

        .kpi-card:nth-child(4) {
            animation-delay: 0.20s;
        }
    </style>
</head>
<body>

    <!-- ── Sidebar ── -->
    <aside class="sidebar">
        <div class="sidebar-logo">NWU · SDMS</div>
        <div class="sidebar-sub">Datamav Platform</div>

        <div class="nav-label">Main</div>
        <a class="nav-item active" href="#">
            <div class="nav-dot"></div> Dashboard
        </a>
        <a class="nav-item" href="#">
            <div class="nav-dot" style="background:var(--muted)"></div> Students
        </a>
        <a class="nav-item" href="#">
            <div class="nav-dot" style="background:var(--muted)"></div> Enrollment
        </a>
        <a class="nav-item" href="#">
            <div class="nav-dot" style="background:var(--muted)"></div> Results
        </a>

        <div class="nav-label">Finance & HR</div>
        <a class="nav-item" href="#">
            <div class="nav-dot" style="background:var(--muted)"></div> Payments
        </a>
        <a class="nav-item" href="#">
            <div class="nav-dot" style="background:var(--muted)"></div> Background Checks
        </a>
        <a class="nav-item" href="#">
            <div class="nav-dot" style="background:var(--muted)"></div> Employability
        </a>

        <div class="nav-label">Academic</div>
        <a class="nav-item" href="#">
            <div class="nav-dot" style="background:var(--muted)"></div> Modules
        </a>
        <a class="nav-item" href="#">
            <div class="nav-dot" style="background:var(--muted)"></div> Assessments
        </a>
        <a class="nav-item" href="#">
            <div class="nav-dot" style="background:var(--muted)"></div> Attendance
        </a>

        <div class="sidebar-footer">
            NWU SDMS &copy; @DateTime.Now.Year<br />
            Powered by Datamav
        </div>
    </aside>

    <!-- ── Main Content ── -->
    <main class="main">

        <!-- Header -->
        <div class="page-header">
            <div>
                <div class="page-title">Student Overview</div>
                <div class="page-subtitle">North-West University — Academic Year @DateTime.Now.Year</div>
            </div>
            <div class="header-badge">
                Last synced: <span>@DateTime.Now.ToString("dd MMM yyyy, HH:mm")</span>
            </div>
        </div>

        <!-- ── KPI Row 1 ── -->
        <div class="section-label">Key Performance Indicators</div>
        <div class="kpi-grid">

            <div class="kpi-card blue">
                <div class="kpi-icon">🎓</div>
                <div class="kpi-label">Total Students</div>
                <div class="kpi-value">@Model.TotalStudents</div>
                <div class="kpi-sub">Registered in SDMS</div>
            </div>

            <div class="kpi-card green">
                <div class="kpi-icon">✅</div>
                <div class="kpi-label">Active Students</div>
                <div class="kpi-value">@Model.ActiveStudents</div>
                <div class="kpi-sub">Currently enrolled</div>
            </div>

            <div class="kpi-card amber">
                <div class="kpi-icon">💳</div>
                <div class="kpi-label">Outstanding Fees</div>
                <div class="kpi-value">@Model.StudentsWithOutstandingFees</div>
                <div class="kpi-sub">Students with balance due</div>
            </div>

            <div class="kpi-card red">
                <div class="kpi-icon">🚩</div>
                <div class="kpi-label">Flagged Students</div>
                <div class="kpi-value">@Model.FlaggedStudents</div>
                <div class="kpi-sub">Criminal record flagged</div>
            </div>

        </div>

        <!-- ── KPI Row 2 ── -->
        <div class="kpi-grid" style="grid-template-columns: repeat(3,1fr); margin-bottom:28px;">

            <div class="kpi-card cyan">
                <div class="kpi-icon">💰</div>
                <div class="kpi-label">Total Outstanding (R)</div>
                <div class="kpi-value">R @Model.TotalOutstandingFees.ToString("N0")</div>
                <div class="kpi-sub">Across all students</div>
            </div>

            <div class="kpi-card purple">
                <div class="kpi-icon">📅</div>
                <div class="kpi-label">Avg Attendance</div>
                <div class="kpi-value">@Model.AvgAttendance.ToString("F1")%</div>
                <div class="kpi-sub">All modules combined</div>
            </div>

            <div class="kpi-card gold">
                <div class="kpi-icon">💼</div>
                <div class="kpi-label">Avg Employability</div>
                <div class="kpi-value">@Model.AvgEmployabilityScore.ToString("F1")</div>
                <div class="kpi-sub">Score out of 10</div>
            </div>

        </div>

        <!-- ── Charts Row 1 ── -->
        <div class="section-label">Analytics</div>
        <div class="chart-grid">

            <div class="chart-card">
                <div class="chart-title">Student Status</div>
                <div class="chart-desc">Distribution by enrolment status</div>
                <div class="chart-wrap">
                    <canvas id="statusChart"></canvas>
                </div>
            </div>

            <div class="chart-card">
                <div class="chart-title">Grade Distribution</div>
                <div class="chart-desc">Results breakdown across all modules</div>
                <div class="chart-wrap">
                    <canvas id="gradeChart"></canvas>
                </div>
            </div>

            <div class="chart-card">
                <div class="chart-title">Attendance Breakdown</div>
                <div class="chart-desc">Present / Absent / Late records</div>
                <div class="chart-wrap">
                    <canvas id="attendanceChart"></canvas>
                </div>
            </div>

        </div>

        <!-- ── Charts Row 2 ── -->
        <div class="chart-grid-2">

            <div class="chart-card">
                <div class="chart-title">Payment Status</div>
                <div class="chart-desc">Paid vs partial vs outstanding</div>
                <div class="chart-wrap">
                    <canvas id="paymentChart"></canvas>
                </div>
            </div>

            <div class="chart-card">
                <div class="chart-title">Enrollment by Program</div>
                <div class="chart-desc">Top programs by student count</div>
                <div class="chart-wrap">
                    <canvas id="programChart"></canvas>
                </div>
            </div>

        </div>

        <!-- ── Student Table ── -->
        <div class="section-label">Student Records</div>
        <div class="table-card">
            <div class="table-header">
                <div class="table-header-title">All Students</div>
                <div style="display:flex;align-items:center;gap:12px;">
                    <div class="search-wrap">
                        <span class="search-icon">🔍</span>
                        <input class="search-input" type="text" id="searchInput" placeholder="Search student..." oninput="filterTable()" />
                    </div>
                    <div class="table-count">@Model.StudentSummaries.Count shown</div>
                </div>
            </div>

            <div style="overflow-x:auto;">
                <table id="studentTable">
                    <thead>
                        <tr>
                            <th>#ID</th>
                            <th>Full Name</th>
                            <th>Status</th>
                            <th>Avg Marks</th>
                            <th>Grade</th>
                            <th>Attendance</th>
                            <th>Balance (R)</th>
                            <th>Background</th>
                            <th>Employability</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.StudentSummaries)
                        {
                            var attendColor = s.AttendancePct >= 75 ? "green" : s.AttendancePct >= 50 ? "amber" : "red";
                            var markColor = s.AvgMarks >= 60 ? "score-high" : s.AvgMarks >= 50 ? "score-mid" : "score-low";
                            var empColor = s.EmployabilityScore >= 7 ? "score-high" : s.EmployabilityScore >= 5 ? "score-mid" : "score-low";

                            <tr>
                                <td style="color:var(--muted);font-size:12px;">@s.StudentId</td>
                                <td>@s.FullName</td>
                                <td>
                                    <span class="badge @(s.Status?.ToLower() == "active" ? "badge-active" : "badge-inactive")">
                                        @(s.Status ?? "Unknown")
                                    </span>
                                </td>
                                <td>
                                    <span class="score-pill @markColor">@s.AvgMarks.ToString("F1")%</span>
                                </td>
                                <td style="font-weight:600;color:var(--text);">@s.TopGrade</td>
                                <td>
                                    <div class="progress-wrap">
                                        <div class="progress-bar">
                                            <div class="progress-fill @attendColor" style="width:@(Math.Min(s.AttendancePct,100))%"></div>
                                        </div>
                                        <span class="progress-val">@s.AttendancePct.ToString("F0")%</span>
                                    </div>
                                </td>
                                <td>
                                    @if (s.OutstandingBalance <= 0)
                                    {
                                        <span class="badge badge-paid">Paid</span>
                                    }
                                    else
                                    {
                                        <span style="color:var(--warning);font-weight:600;">R @s.OutstandingBalance.ToString("N0")</span>
                                    }
                                </td>
                                <td>
                                    @if (s.HasCriminalRecord)
                                    {
                                        <span class="badge badge-flagged">⚠ Flagged</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-clear">✓ Clear</span>
                                    }
                                </td>
                                <td>
                                    <span class="score-pill @empColor">@s.EmployabilityScore.ToString("F1")</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </main>

    <!-- ── Chart.js Scripts ── -->
    <script>
        const PALETTE = ['#3b82f6', '#06b6d4', '#10b981', '#f59e0b', '#ef4444', '#a855f7', '#fbbf24', '#64748b'];

        const chartDefaults = {
            plugins: { legend: { labels: { color: '#94a3b8', font: { size: 12 } } } },
            scales: {}
        };

        // Helper: build doughnut
        function doughnut(id, labels, values) {
            new Chart(document.getElementById(id), {
                type: 'doughnut',
                data: {
                    labels: labels,
                    datasets: [{ data: values, backgroundColor: PALETTE, borderWidth: 0, hoverOffset: 6 }]
                },
                options: {
                    cutout: '65%',
                    plugins: { legend: { position: 'bottom', labels: { color: '#94a3b8', font: { size: 11 }, padding: 12 } } }
                }
            });
        }

        // Helper: build bar
        function bar(id, labels, values, color) {
            new Chart(document.getElementById(id), {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        data: values,
                        backgroundColor: color || PALETTE[0],
                        borderRadius: 6,
                        borderSkipped: false
                    }]
                },
                options: {
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { ticks: { color: '#64748b' }, grid: { color: '#1f2d45' } },
                        y: { ticks: { color: '#64748b' }, grid: { color: '#1f2d45' } }
                    }
                }
            });
        }

        // ── Status Chart ──
        doughnut('statusChart',
            [@Html.Raw(string.Join(",", Model.StatusDistribution.Select(d => $"'{d.Label}'")))],
            [@string.Join(",", Model.StatusDistribution.Select(d => d.Value))]
        );

        // ── Grade Chart ──
        bar('gradeChart',
            [@Html.Raw(string.Join(",", Model.GradeDistribution.Select(d => $"'{d.Label}'")))],
            [@string.Join(",", Model.GradeDistribution.Select(d => d.Value))],
            PALETTE
        );

        // ── Attendance Chart ──
        doughnut('attendanceChart',
            [@Html.Raw(string.Join(",", Model.AttendanceDistribution.Select(d => $"'{d.Label}'")))],
            [@string.Join(",", Model.AttendanceDistribution.Select(d => d.Value))]
        );

        // ── Payment Chart ──
        doughnut('paymentChart',
            [@Html.Raw(string.Join(",", Model.PaymentDistribution.Select(d => $"'{d.Label}'")))],
            [@string.Join(",", Model.PaymentDistribution.Select(d => d.Value))]
        );

        // ── Program Chart ──
        bar('programChart',
            [@Html.Raw(string.Join(",", Model.EnrollmentByProgram.Select(d => $"'{d.Label}'")))],
            [@string.Join(",", Model.EnrollmentByProgram.Select(d => d.Value))],
            '#06b6d4'
        );

        // ── Table Search ──
        function filterTable() {
            const q = document.getElementById('searchInput').value.toLowerCase();
            document.querySelectorAll('#studentTable tbody tr').forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
            });
        }
    </script>

</body>
</html>
