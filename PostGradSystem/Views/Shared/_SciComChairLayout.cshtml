@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SciCom Chair</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.3/css/dataTables.bootstrap5.min.css" />

    <link rel="stylesheet" href="~/css/site.css" />

    <style>
        body {
            background-color: #f5f5f5;
        }

        .sidebar {
            width: 240px;
            height: 95vh;
            margin: 15px;
            background-color: #fff;
        }

            .sidebar .nav-link {
                border-radius: 10px;
                padding: 10px 12px;
                color: #333;
                font-size: 14px;
                transition: all 0.2s ease;
            }

                .sidebar .nav-link i {
                    margin-right: 8px;
                }

                .sidebar .nav-link:hover {
                    background-color: #f1f1f1;
                    transform: translateX(3px);
                }

                .sidebar .nav-link.active {
                    background-color: #4b1979;
                    color: #fff;
                }

        .content-area {
            margin: 15px;
        }

        .topbar {
            background-color: #fff;
            border-radius: 12px;
            padding: 10px 15px;
            box-shadow: 0 0.125rem 0.25rem rgba(0,0,0,0.075);
        }

    </style>
</head>

<body>

    <div class="d-flex">

        <div class="sidebar card shadow border-0 rounded-4 p-3">

            <h5 class="text-center mb-4">SciCom Chair Panel</h5>

            <ul class="nav flex-column">

                <li class="nav-item mb-2">
                    <a class="nav-link active" asp-controller="SciComChair" asp-action="Index">
                        <i class="bi bi-speedometer2"></i> Dashboard
                    </a>
                </li>

                <li class="nav-item mb-2">
                    <a class="nav-link d-flex justify-content-between align-items-center"
                       data-bs-toggle="collapse"
                       href="#studentsMenu"
                       role="button">
                        <span><i class="bi bi-people"></i> Students</span>
                        <i class="bi bi-chevron-down small"></i>
                    </a>

                    <div class="collapse ps-3" id="studentsMenu">
       
                        <a class="nav-link sub-link" asp-controller="SciComChair" asp-action="ListAssignedStudent">
                            • View Students
                        </a>
                    </div>
                </li>

 
   
                <li class="nav-item mb-2">
                    <a class="nav-link d-flex justify-content-between align-items-center"
                       data-bs-toggle="collapse"
                       href="#supervisionMenu">
                        <span><i class="bi bi-person-badge"></i> Supervision</span>
                        <i class="bi bi-chevron-down small"></i>
                    </a>

                    <div class="collapse ps-3" id="supervisionMenu">
                        <a class="nav-link sub-link" asp-controller="SciComChair" asp-action="ListStudentSupervisor">
                            • View Supervision
                        </a>

                    </div>
                </li>


                <li class="nav-item mb-2">
                    <a class="nav-link d-flex justify-content-between align-items-center"
                       data-bs-toggle="collapse"
                       href="#reportsMenu">
                        <span><i class="bi bi-file-earmark-text"></i> Reports</span>
                        <i class="bi bi-chevron-down small"></i>
                    </a>

                    <div class="collapse ps-3" id="reportsMenu">
                     
                        <a class="nav-link sub-link" asp-controller="SciComChair" asp-action="ListReport">
                            • Progress Reports
                        </a>
                    </div>
                </li>

                <li class="nav-item mt-4">

                    <a class="nav-link text-danger" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                        <i class="bi bi-box-arrow-right"></i> Logout
                    </a>
                </li>

            </ul>
        </div>

        <div class="flex-grow-1 content-area">

            <div class="topbar mb-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0">@ViewData["Title"]</h6>

                <div>
                    <a class="me-2 text-decoration-none text-dark" asp-area="Identity" asp-page="/Account/Manage/Index">
                        Hello @User.Identity?.Name!
                    </a>

                    <i class="bi bi-person-circle"></i>
                </div>
            </div>

            <div class="card shadow border-0 rounded-4 p-4">
                @RenderBody()
            </div>

        </div>

    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.datatables.net/1.13.3/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.3/js/dataTables.bootstrap5.min.js"></script>

    <script src="https://cdn.tiny.cloud/1/g28lhnxtlihu4l4a381gw7tz47voznshwbi10lmsvlekrfme/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>


    @RenderSection("Scripts", required: false)
    <script>
        document.querySelectorAll('[data-bs-toggle="collapse"]').forEach(item => {
            item.addEventListener('click', function () {
                const icon = this.querySelector('.bi-chevron-down');
                if (icon) {
                    icon.classList.toggle('rotate');
                }
            });
        });
    </script>

</body>
</html>